{
  "libc": {
    "version": "wasi-sdk-32",
    "build": "wasm/libc/build.sh",
    "module": "libc.so",
    "includes": [],
    "provides": []
  },
  "libcxx": {
    "version": "21.1.8",
    "build": "wasm/libcxx/build.sh",
    "module": "libc++.so",
    "includes": [],
    "cxxIncludes": ["include/c++/v1"],
    "links": ["lib/libc++.so"],
    "provides": ["libc++.so"]
  },
  "cpython": {
    "version": "3.14.4",
    "build": "wasm/cpython/build.sh",
    "module": "libpython3.14.wasm",
    "includes": ["include/python3.14"],
    "environment": {"PYTHONHOME": "."},
    "provides": ["python3", "python3.14", "python3.8", "python3.6"]
  },
  "zlib": {
    "version": "1.3.1",
    "build": "wasm/zlib/build.sh",
    "archives": ["lib/libz.a"],
    "includes": ["include"]
  },
  "hdf5": {
    "version": "2.2.0",
    "systemLibraries": ["zlib"],
    "build": "wasm/hdf5/build.sh",
    "archives": ["lib/libhdf5_hl.a", "lib/libhdf5.a"],
    "includes": ["include"]
  },
  "ModelicaSDF": {
    "version": "0.4.5",
    "systemLibraries": ["hdf5", "zlib", "libcxx"],
    "build": "wasm/ModelicaSDF/build.sh",
    "module": "libModelicaSDF.wasm",
    "includes": ["include"],
    "provides": ["ModelicaSDF"]
  },
  "ExternalMediaLib": {
    "version": "4.1.1",
    "systemLibraries": ["libcxx"],
    "build": "wasm/ExternalMediaLib/build.sh",
    "module": "libExternalMediaLib.wasm",
    "includes": ["include"],
    "provides": ["ExternalMediaLib"]
  },
  "netcdf": {
    "version": "4.9.3",
    "systemLibraries": ["zlib"],
    "build": "wasm/netcdf/build.sh",
    "module": "libnetcdf.wasm",
    "includes": ["include"],
    "provides": ["netcdf"]
  }
}
